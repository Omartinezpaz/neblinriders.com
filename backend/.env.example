# Entorno de Producción / Desarrollo
NODE_ENV=production
HOST=0.0.0.0
PORT=1337

# Base de Datos PostgreSQL (Supabase / Neon)
# Formato: postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/neblina_db

# Secretos de Strapi (Generar con: openssl rand -hex 32)
APP_KEYS=secret1,secret2,secret3,secret4
API_TOKEN_SALT=my_api_token_salt
ADMIN_JWT_SECRET=my_admin_jwt_secret
TRANSFER_TOKEN_SALT=my_transfer_token_salt
JWT_SECRET=my_jwt_secret
